# Copy this file to `.env` in the project root and fill in your values.
# `.env` is git-ignored and bundled as a Flutter asset at build time.
# Only the public (anon / publishable) key belongs here — never a service_role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
